{
  "name": "@matinfo/vitepress-plugin-exercices-form",
  "type": "module",
  "version": "1.0.0",
  "description": "VitePress plugin for interactive exercises with answer boxes and client-side PDF generation",
  "author": "matinfo",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matinfo/vitepress-plugin-exercices-form.git"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "exercises",
    "answer-box",
    "pdf",
    "education"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vitepress-plugin-exercices-form.js",
      "require": "./dist/vitepress-plugin-exercices-form.umd.cjs",
      "default": "./dist/vitepress-plugin-exercices-form.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/vitepress-plugin-exercices-form.umd.cjs",
  "module": "./dist/vitepress-plugin-exercices-form.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc",
    "pack": "npm pack",
    "test:install": "npm run build && npm run pack && cd test-project && npm install",
    "test:dev": "npm run test:install && cd test-project && npm run docs:dev",
    "test:dev:only": "cd test-project && npm run docs:dev",
    "test:build": "npm run test:install && cd test-project && npm run docs:build"
  },
  "peerDependencies": {
    "vitepress": "^1.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^10.2.0",
    "jsdom": "^26.1.0",
    "markdown-it": "^14.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.2",
    "vue": "^3.5.32",
    "vue-tsc": "^2.2.12"
  }
}
